{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.dotfiles/config/codex/notify.sh\" session-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.dotfiles/config/codex/notify.sh\" subagent-stop"
          }
        ]
      }
    ]
  }
}
